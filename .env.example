# ── Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default: claude-opus-5-5).
# claude-sonnet-5-5 is faster/cheaper; claude-haiku-5-5 is fastest/cheapest.
# CLAUDE_MODEL=claude-opus-5-5

# ── Twilio ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Your Twilio number, E.164 format
TWILIO_PHONE_NUMBER=+15555550100

# ── You ─────────────────────────────────────────────────
# Comma-separated phone numbers allowed to talk to Jarvis (E.164). Everyone else is rejected.
ALLOWED_NUMBERS=+15555550123
# What Jarvis should call you
OWNER_NAME=Sir
# Your timezone (IANA name) — used for times and reminders
TIMEZONE=America/New_York
# Your default city for weather when you don't name one
HOME_CITY=New York

# ── Server ──────────────────────────────────────────────
# The public https URL Twilio uses to reach this server (no trailing slash).
# e.g. https://jarvis.onrender.com or your ngrok URL
PUBLIC_URL=https://your-public-url.example.com
# Where to keep memory/reminders
DATABASE_PATH=jarvis.db

# ── Voice (optional) ────────────────────────────────────
# Text-to-speech settings for Twilio ConversationRelay.
# TTS_PROVIDER=ElevenLabs
# TTS_VOICE=
# Spoken when a call connects
# WELCOME_GREETING=At your service. How can I help?

# ── Web search (optional) ───────────────────────────────
# Let Jarvis search the web (billed per search by Anthropic). true/false
# ENABLE_WEB_SEARCH=true

# Set to false ONLY for local testing without Twilio signatures
# VALIDATE_TWILIO_SIGNATURE=true
